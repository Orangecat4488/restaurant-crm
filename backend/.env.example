# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm_restaurant

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-32chars-min-length-crm
JWT_REFRESH_SECRET=your-super-secret-refresh-key-32chars-min-crm
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# Stripe
STRIPE_SECRET_KEY=sk_test_51MockStripeSecretKeyForTestingCRM12345
STRIPE_PUBLIC_KEY=pk_test_51MockStripePublicKeyForTestingCRM12345
STRIPE_WEBHOOK_SECRET=whsec_MockStripeWebhookSecret1234567890

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@crm-restaurant.com
SMTP_PASS=app-specific-password
SMTP_FROM=CRM Restaurant Licensing <noreply@crm-restaurant.com>

# Application
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# Security
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_LOCK_TIME=30

# Encryption (32-character AES-256 key)
LICENSE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
